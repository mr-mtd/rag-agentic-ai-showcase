# --- Development (npm run dev / npm run preview) ---
# Where the Vite server proxies /api requests. Defaults to the hosted backend.
# VITE_API_TARGET=http://localhost:8080

# --- Production build (npm run build) ---
# Backend URL baked into the build. Leave empty to call /api on the same origin
# (behind a reverse proxy). If set, the backend must allow this site's origin via CORS.
# In GitHub Actions this comes from the repository variable VITE_API_BASE_URL.
# VITE_API_BASE_URL=https://hybrid-rag.9jn1qt7414py4.us-east-2.cs.amazonlightsail.com
