# Nothing here is secret. VITE_* values are baked into the JavaScript bundle, so
# never put an API key in this file: the keys live on the backends.

# --- Development (npm run dev / npm run preview) ---
# Where the Vite server proxies /api/ask (Knowledge Assistant). Defaults to the hosted RAG backend.
# VITE_API_TARGET=http://localhost:8080
# Where the Vite server proxies /api/v1/chat (Transportation Assistant). Defaults to the hosted orchestrator.
# VITE_ORCHESTRATOR_TARGET=http://localhost:8081

# --- Production build (npm run build) ---
# RAG backend URL baked into the build. Leave empty to call /api/ask on the same
# origin (the deployed site's CloudFront /api/* behavior forwards it to Lightsail).
# VITE_API_BASE_URL=

# Orchestrator URL baked into the build. Empty means same origin. The deployed site
# uses the orchestrator's CloudFront distribution, which allows this site via CORS.
# VITE_ORCHESTRATOR_BASE_URL=https://d23pzgqslfrw1a.cloudfront.net

# Client-side request timeouts in milliseconds (default 60000, matching the
# 60 s CloudFront origin timeout in front of both backends).
# VITE_API_TIMEOUT_MS=60000
# VITE_ORCHESTRATOR_TIMEOUT_MS=60000
